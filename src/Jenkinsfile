// =============================================================================
// Jenkinsfile — Online Boutique Monorepo (Minimal Orchestrator)
// =============================================================================
// All pipeline logic lives in: devsecops-tools/vars/onlineBoutiquePipeline.groovy
// Each Jenkins job passes APP_NAME to identify which service to build.
// =============================================================================

@Library('devsecops-tools') _

pipeline {
    agent {
        kubernetes {
            yaml readTrusted('jenkins/pod.yaml')
            defaultContainer 'devsecops'
        }
    }

    parameters {
        string(name: 'APP_NAME', defaultValue: '', description: 'Service name under src/ (e.g., frontend, cartservice)')
        booleanParam(name: 'FORCE_BUILD', defaultValue: false, description: 'Build even if no changes detected for this service')
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
        skipDefaultCheckout()
    }

    stages {
        stage('Run Pipeline') {
            steps {
                script {
                    def appName = params.APP_NAME?.trim() ?: env.APP_NAME?.trim()
                    onlineBoutiquePipeline(appName: appName, forceBuild: params.FORCE_BUILD)
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline completed for ${params.APP_NAME ?: env.APP_NAME ?: 'unknown'}"
        }
        failure {
            echo "Pipeline FAILED for ${params.APP_NAME ?: env.APP_NAME ?: 'unknown'}"
        }
    }
}
