// =============================================================================
// Jenkinsfile — Online Boutique Monorepo (Minimal Orchestrator)
// =============================================================================
// All pipeline logic lives in: devsecops-tools/vars/onlineBoutiquePipeline.groovy
// Each Jenkins job passes APP_NAME to identify which service to build.
// =============================================================================

@Library('devsecops-tools@main') _

pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                metadata:
                  labels:
                    jenkins-agent: online-boutique
                spec:
                  serviceAccountName: jenkins
                  containers:
                  - name: devsecops
                    image: 730335384723.dkr.ecr.ap-south-1.amazonaws.com/devsecops:1.0.0
                    command: ['cat']
                    tty: true
                    env:
                    - name: AWS_REGION
                      value: ap-south-1
                    - name: AWS_DEFAULT_REGION
                      value: ap-south-1
                    - name: AWS_STS_REGIONAL_ENDPOINTS
                      value: regional
                    - name: DOCKER_HOST
                      value: tcp://localhost:2375
                  - name: docker
                    image: docker:27-dind
                    securityContext:
                      privileged: true
                    args:
                    - --host=tcp://0.0.0.0:2375
                    - --host=unix:///var/run/docker.sock
                    - --tls=false
                    env:
                    - name: DOCKER_TLS_CERTDIR
                      value: ""
                    volumeMounts:
                    - name: docker-storage
                      mountPath: /var/lib/docker
                  volumes:
                  - name: docker-storage
                    emptyDir: {}
            '''
            defaultContainer 'devsecops'
        }
    }

    parameters {
        string(name: 'APP_NAME', defaultValue: '', description: 'Service name under src/ (e.g., frontend, cartservice)')
        booleanParam(name: 'FORCE_BUILD', defaultValue: false, description: 'Build even if no changes detected for this service')
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
        skipDefaultCheckout()
    }

    stages {
        stage('Run Pipeline') {
            steps {
                script {
                    def appName = params.APP_NAME?.trim() ?: env.APP_NAME?.trim()
                    onlineBoutiquePipeline(appName: appName, forceBuild: params.FORCE_BUILD)
                }
            }
        }
    }

    post {
        always {
            deleteDir()
        }
        success {
            echo "Pipeline completed for ${params.APP_NAME ?: env.APP_NAME ?: 'unknown'}"
        }
        failure {
            echo "Pipeline FAILED for ${params.APP_NAME ?: env.APP_NAME ?: 'unknown'}"
        }
    }
}
