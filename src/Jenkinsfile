// =============================================================================
// Jenkinsfile — Online Boutique CI/CD Pipeline
// =============================================================================
// Project  : E-commerce Online Boutique (Microservices)
// Repo     : https://github.com/DevOps-Experiments-ORG/E-commerce-Online-Boutique
// Registry : 730335384723.dkr.ecr.ap-south-1.amazonaws.com/devsecops
// Branch   : feature-1 (deploy gate)
// Agent    : Docker-based Jenkins agent with DevSecOps tooling
// =============================================================================

pipeline {
    agent {
        docker {
            alwaysPull true
            image '730335384723.dkr.ecr.ap-south-1.amazonaws.com/devsecops:1.0.0'
            registryUrl 'https://730335384723.dkr.ecr.ap-south-1.amazonaws.com'
            registryCredentialsId 'ecr:ap-south-1:AWSKey'
            args '-v /var/run/docker.sock:/var/run/docker.sock -u 0:0'
        }
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['local', 'dev', 'prod'], description: 'Target environment')
        string(name: 'SERVICES', defaultValue: '', description: 'Comma-separated services (empty = auto-detect)')
        booleanParam(name: 'FORCE_FULL_BUILD', defaultValue: false, description: 'Build all services')
        booleanParam(name: 'SKIP_DEPLOY', defaultValue: false, description: 'Skip GitOps update and ArgoCD sync')
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
        skipDefaultCheckout()
    }

    environment {
        AWS_REGION           = 'ap-south-1'
        AWS_ACCOUNT_ID       = '730335384723'
        SNS_TOPIC_NAME       = 'Ai-powered'
        DEPLOY_GITOPS_REPO   = "E-commerce-Online-Boutique"
        DEPLOY_TARGET_FILE   = "microservices/applications/pramaan-beta/dev-mock-aa-prod/values-pre-prod.yaml"
        DEPLOY_TARGET_BRANCH = "feature-1"
        REGISTRY             = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPOSITORY       = "devsecops"
        SECRET_NAME          = "shared/ppd/finvuaaserver-secret"
        NODE_ENV             = "local"
        PIPELINE_ENV         = "${params.ENVIRONMENT ?: 'local'}"
        DOCKER_BUILDKIT      = '1'
    }

    stages {
        // ─────────────────────────────────────────────────
        // Stage 1: Checkout
        // ─────────────────────────────────────────────────
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 2: Fetch Secrets from AWS SecretsManager
        // ─────────────────────────────────────────────────
        stage('Fetch env from AWS SecretsManager') {
            steps {
                script {
                    sh '''
                        unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
                        aws secretsmanager get-secret-value \
                            --region ${AWS_REGION} \
                            --secret-id ${SECRET_NAME} \
                            --query SecretString \
                            --output text > .env || { echo "Failed to fetch secret"; exit 1; }
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 3: Sensitive Information Check
        // ─────────────────────────────────────────────────
        stage('Sensitive Information Check - Git Secret') {
            steps {
                echo 'Scanning for sensitive information...'
                sh '''
                    echo "Running git-secrets scan..."
                    # git secrets --scan || true
                '''
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 4: Build Code
        // ─────────────────────────────────────────────────
        stage('Build Code') {
            steps {
                echo "Building packages..."
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 5: Unit Tests
        // ─────────────────────────────────────────────────
        stage('Run Tests') {
            steps {
                echo 'Testing...'
                sh '''
                    echo 'Running unit tests...'
                '''
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 6: Integration Testing
        // ─────────────────────────────────────────────────
        stage('Integration Testing') {
            steps {
                echo 'Running Integration tests cases...'
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 7: AI PR Review (only on Pull Requests)
        // ─────────────────────────────────────────────────
        stage('AI PR Review') {
            when { expression { env.CHANGE_ID } }
            steps {
                script {
                    def response = httpRequest(
                        url: "http://obs-assistant.default.svc.cluster.local:5000/review-pr",
                        httpMode: 'POST',
                        contentType: 'APPLICATION_JSON',
                        requestBody: """{"pr_number": ${env.CHANGE_ID}}""",
                        timeout: 60
                    )
                    echo "PR Review posted: ${response.content}"
                }
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 8: SonarQube Scan (disabled — uncomment when ready)
        // ─────────────────────────────────────────────────
        // stage('SonarQube Scan') {
        //     steps {
        //         echo 'Running SonarQube Scan...'
        //         // sonarQubeScan('online-boutique', 'nodejs')
        //     }
        // }

        // stage('Quality Gate Check') {
        //     steps {
        //         echo 'Running SonarQube Quality Gate check...'
        //         // qualityGateCheck()
        //     }
        // }

        // ─────────────────────────────────────────────────
        // Stage 9: Build Docker Image
        // ─────────────────────────────────────────────────
        stage('Build Docker Image') {
            steps {
                script {
                    echo 'Building Docker Image...'
                    env.IMAGE_TAG = "${REGISTRY}/${ECR_REPOSITORY}:${env.BUILD_NUMBER}"
                    sh """
                        docker build \
                            --build-arg NODE_ENV=${NODE_ENV} \
                            --build-arg ENV_FILE=.env \
                            -t ${env.IMAGE_TAG} \
                            -f ./Dockerfile .
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 10: Container Image Security Scan
        // ─────────────────────────────────────────────────
        stage('Container Image Scan') {
            steps {
                echo 'Scanning Docker image for vulnerabilities...'
                sh """
                    echo "Running Trivy scan on ${env.IMAGE_TAG}..."
                    # trivy image --exit-code 0 --severity HIGH,CRITICAL ${env.IMAGE_TAG}
                """
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 11: Push Docker Image to ECR
        // ─────────────────────────────────────────────────
        stage('Push Docker Image') {
            when {
                branch "${DEPLOY_TARGET_BRANCH}"
            }
            steps {
                script {
                    echo 'Pushing Docker image to ECR...'
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login --username AWS --password-stdin ${REGISTRY}
                        docker push ${env.IMAGE_TAG}
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 12: Update Image Tag in GitOps Repo
        // ─────────────────────────────────────────────────
        stage('Update Image Tag in GitOps') {
            when {
                branch "${DEPLOY_TARGET_BRANCH}"
            }
            steps {
                echo "Pushing changes to ${env.DEPLOY_GITOPS_REPO}"
                // TODO: Implement GitOps image tag update
                // updateGitOps()
            }
        }

        // ─────────────────────────────────────────────────
        // Stage 13: Post-Deployment Tests
        // ─────────────────────────────────────────────────
        stage('Post-Deployment Tests') {
            when {
                branch "${DEPLOY_TARGET_BRANCH}"
            }
            steps {
                echo 'Running post-deployment tests...'
            }
        }
    }

    // ─────────────────────────────────────────────────────
    // Post Actions: Cleanup & Notifications
    // ─────────────────────────────────────────────────────
    post {
        always {
            echo 'Cleaning up resources...'
            sh 'docker system prune -f || true'
            cleanWs()
            snsPublish(
                topicArn: "arn:aws:sns:${env.AWS_REGION}:${env.AWS_ACCOUNT_ID}:${env.SNS_TOPIC_NAME}",
                subject: "Jenkins: ${env.JOB_NAME}-${env.BUILD_NUMBER}",
                message: "Build status notification for ${env.JOB_NAME}: ${currentBuild.currentResult}"
            )
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
