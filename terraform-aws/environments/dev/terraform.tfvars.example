# =============================================================================
# Dev Environment – Variable Values
# =============================================================================

aws_region   = "ap-southeast-1"
project_name = "online-boutique"
environment  = "dev"

# VPC
vpc_cidr           = "10.0.0.0/16"
az_count           = 3
single_nat_gateway = true

# EKS
cluster_version     = "1.36"
node_instance_types = ["t3.medium"]
capacity_type       = "SPOT"
node_disk_size      = 50
node_desired_size   = 3
node_min_size       = 2
node_max_size       = 5

# EKS Cluster Admin Access (IAM ARNs – both human users and CI roles)
cluster_admin_arns = [
  "arn:aws:iam::798836978890:user/minhhuy",
  "arn:aws:iam::798836978890:role/online-boutique-github-terraform",
]

# ElastiCache
redis_version            = "7.1"
redis_node_type          = "cache.t3.micro"
redis_num_cache_clusters = 2
